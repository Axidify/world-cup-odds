# Active LLM provider: vllm | openai | openrouter | gemini | anthropic
LLM_PROVIDER=vllm
LLM_CONCURRENCY=4

# vLLM (local)
VLLM_BASE_URL=http://192.168.28.230:8001/v1
VLLM_MODEL=Qwen3.6-35B-A3B-FP8
VLLM_API_KEY=not-needed
VLLM_CONCURRENCY=4
VLLM_MAX_TOKENS=512
VLLM_TIMEOUT_MS=120000

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=alibaba/qwen3.7-plus
APP_URL=http://localhost:3000

# AI cache
PREDICTION_CACHE_TTL_DAYS=7
ANALYZE_RATE_LIMIT_PER_MIN=30

# Simulation
SIMULATION_ITERATIONS=5000
SIMULATION_SEED=42
TOURNAMENT_LOCK_AT=

# Gemini / Anthropic (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Web search (pick one: tavily | serper)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

NEWS_POLL_INTERVAL_HOURS=6
RESULTS_POLL_INTERVAL_MINUTES=15

# Learning (Phase 5C — default off)
CALIBRATION_ENABLED=0

# Office betting
OFFICE_POOL_NAME=Office World Cup 2026
POOL_VIG_PCT=0
ADMIN_PIN=
POOL_CURRENCY=MYR
POOL_MIN_STAKE_MYR=1

# Database
DATABASE_PATH=./data/worldcup.db
