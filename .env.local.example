# Active LLM provider: vllm | openai | openrouter | gemini | anthropic
LLM_PROVIDER=vllm
LLM_CONCURRENCY=4

# vLLM (local)
VLLM_BASE_URL=http://192.168.28.230:8001/v1
VLLM_MODEL=Qwen3.6-35B-A3B-FP8
VLLM_API_KEY=not-needed
VLLM_CONCURRENCY=2
VLLM_MAX_TOKENS=512
VLLM_TIMEOUT_MS=120000

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=alibaba/qwen3.7-plus
# Must match the port Next.js listens on (poller uses this for auto-analyze)
APP_URL=http://localhost:3000

# AI cache
PREDICTION_CACHE_TTL_DAYS=7
ANALYZE_RATE_LIMIT_PER_MIN=30

# Simulation
SIMULATION_ITERATIONS=5000
SIMULATION_SEED=42

# Gemini / Anthropic (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Official match results (recommended) — free at https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_SEASON=2026
# FOOTBALL_DATA_TIMEOUT_MS=30000

# Big Balls — live scores during matches (required for in-play scores)
# https://bigballsdata.com — get key at /dashboard/keys
BBS_API_KEY=
# Poll live matches only while kickoff → ~2h window (default 60s)
LIVE_SCORES_POLL_INTERVAL_SECONDS=60
# BBS_API_BASE_URL=https://api.bigballsdata.com
# BBS_API_TIMEOUT_MS=30000

# Web search (pick one: tavily | serper) — used for news; results fallback if no scores API
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

NEWS_POLL_INTERVAL_HOURS=6
# Poll interval while matches are in the results window (kickoff + 2h until confirmed)
RESULTS_POLL_INTERVAL_MINUTES=15

# Auto-pipeline (poller) — re-run simulation when results confirm
AUTO_PIPELINE_ENABLED=1
AUTO_SIMULATE_ON_RESULTS=1
AUTO_PIPELINE_ON_START=1
# Set to 1 to auto-call LLM for missing predictions (costly)
AUTO_ANALYZE_MISSING=0
# Seed missing predictions from World Football Elo when analyze is off (default on)
ELO_SEED_MISSING=1
# Refresh eloratings.net seeds on poller startup (default on)
ELO_REFRESH_ON_START=1
# One-shot: overwrite group predictions from Elo on next poller start, then unset
# ELO_RESEED_PREDICTIONS=1

# Learning (Phase 5C — default off)
CALIBRATION_ENABLED=0

# News-impact model — deterministic odds adjustment from squad news (default on).
# Set to false to use raw AI predictions without news adjustment.
NEWS_IMPACT_ENABLED=true
# Max Elo delta from news per team (default 35)
NEWS_IMPACT_MAX_DELTA=35
# Only apply news to fixtures within this many days of kickoff (default 14)
NEWS_IMPACT_FIXTURE_DAYS=14

# Admin PIN for simulation, bulk analyze, result confirm, export
ADMIN_PIN=

# Database
DATABASE_PATH=./data/worldcup.db
